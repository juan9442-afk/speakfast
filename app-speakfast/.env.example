# PLANTILLA — solo nombres, sin valores reales. Se sube al repo.
# Copia este archivo a .env.local y rellena los valores ahí (.env.local NO se sube).
# En Vercel, las mismas variables se cargan en Project → Settings → Environment Variables.

# ── Supabase (Project Settings → API Keys / API) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # o la "anon public" (eyJ...) — pública, la protege RLS
SUPABASE_URL=https://TU-REF.supabase.co                   # la misma URL, para el servidor
SUPABASE_SECRET_KEY=sb_secret_xxx                         # o la "service_role" — SOLO servidor, se salta RLS

# ── URL pública del sitio (para los enlaces de los correos de acceso) ──────
NEXT_PUBLIC_SITE_URL=http://localhost:3000                # en producción: https://tudominio.com

# ── IA — se conectan más adelante en la Sesión 6 ─────────────────────────
AI_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
STT_MODEL=
TTS_MODEL=
AI_DAILY_BUDGET_USD=20

# ── Email (Resend) — Sesión 6 ────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=hola@tudominio.com

# ── Venta (Hotmart) — Sesión 6 ───────────────────────────────────────────
HOTMART_HOTTOK=
